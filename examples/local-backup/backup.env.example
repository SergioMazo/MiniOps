RESTIC_REPOSITORY=/mnt/backup/restic
RESTIC_PASSWORD_FILE=/etc/miniops/secrets/restic-password
MINIOPS_BACKUP_SOURCES_FILE=/etc/miniops/backup-sources
MINIOPS_BACKUP_EXCLUDES_FILE=/etc/miniops/backup-excludes
MINIOPS_RESTORE_TEST_PATHS_FILE=/etc/miniops/restore-test-paths
MINIOPS_BACKUP_TAG=miniops-local
MINIOPS_BACKUP_HOST=miniops-node
MINIOPS_RESTIC_CACHE_DIR=/var/cache/miniops/restic
MINIOPS_RESTIC_LOCK=/run/lock/miniops-restic.lock

