# MiniOps general configuration. Copy to /etc/miniops/miniops.env.
# This file must not contain credentials.

MINIOPS_ADMIN_USER=adminuser
MINIOPS_TIMEZONE=Etc/UTC
MINIOPS_CONFIG_DIR=/etc/miniops
MINIOPS_STATE_DIR=/var/lib/miniops
MINIOPS_CACHE_DIR=/var/cache/miniops
MINIOPS_LOG_DIR=/var/log/miniops

# Optional private network used for administrative SSH access.
MINIOPS_SSH_ALLOWED_CIDR=192.168.x.x/24

# Optional. Set to 1 only after testing Tailscale on the target host.
MINIOPS_ENABLE_TAILSCALE=0

# auto, always, or never
MINIOPS_COLOR=auto

# Optional block device for SMART health, for example /dev/sda.
MINIOPS_SMART_DEVICE=
